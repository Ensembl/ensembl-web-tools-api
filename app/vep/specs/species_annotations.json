    "phenotypes": {
      "id": "phenotypes",
      "order": 30,
      "parsed_as": [
        "phenotype_data"
      ],
      "config": {
        "emit": "plugin",
        "name": "Phenotypes",
        "params": {
          "file": "{path}/Phenotypes.pm_{production_name}_116.gvf.gz",
          "cols": "type&source&phenotype&id&external_id&risk_allele"
        }
      }
    },
    "cadd": {
      "id": "cadd",
      "order": 41,
      "parsed_as": [
        "cadd"
      ],
      "config": {
        "emit": "plugin",
        "name": "CADD",
        "params": {
          "snv": "{path}/{file}"
        }
      }
    }
  },
